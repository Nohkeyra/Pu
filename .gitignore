# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
*.local

# Capacitor-synced web build output inside the Android project.
# Regenerated by `npx cap sync android` from public/ + dist/ — should never be hand-edited or committed.
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/.gradle
android/.idea
android/build
android/app/build

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables (contains secrets, and can override Render's dashboard env vars)
.env
.env.local
.env.*.local

# Firebase client config (client-side keys, but avoid committing for easier rotation
# and to not make the Firebase project ID trivially scrapeable from the repo)
android/app/google-services.json

.env
node_modules/
*.session
*.txt

# Build output
!dist/
!dist/**

# Core dumps (e.g. from a crashed/OOM build process)
core
core.*

# F-32 (audit): Android signing keystores. These were only ignored in
# android/.gitignore as commented-out lines (#*.jks / #*.keystore), meaning
# a keystore dropped anywhere in the repo (e.g. android/app/) would have
# been committed. release.yml decodes the real signing keystore from a
# GitHub Secret at build time and deletes it immediately after use, so no
# keystore should ever legitimately exist in the working tree — this is a
# safety net, not a workflow change.
*.jks
*.keystore
release.keystore
