# Android signing keystores & service account keys (stored in GitHub Secrets)
*.jks
*.keystore
release.keystore
key.properties
android/app/key.properties
firebase-service-account.json

# Firebase Android config is provided by GOOGLE_SERVICES_JSON_BASE64 in CI.
# Local Firebase configuration can be downloaded for development, but must not
# accidentally override the production signing/OAuth configuration in Git.
android/app/google-services.json

