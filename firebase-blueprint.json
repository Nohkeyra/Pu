{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Catering booking orders from customers",
      "type": "object",
      "properties": {
        "to": { "type": "string", "description": "The target company or customer organization" },
        "attn": { "type": "string", "description": "Department or contact attention details" },
        "name": { "type": "string", "description": "Contact person name" },
        "contact": { "type": "string", "description": "Contact telephone number" },
        "email": { "type": "string", "description": "Contact email address" },
        "date": { "type": "string", "description": "Event date (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Event time (HH:MM)" },
        "location": { "type": "string", "description": "Event location full address" },
        "quantity": { "type": "integer", "description": "Number of pax requested" },
        "meals": { "type": "array", "description": "Selected meal types" },
        "menu": { "type": "string", "description": "Selected menu items" },
        "notes": { "type": "string", "description": "Special instructions or notes" },
        "dateTime": { "type": "string", "description": "Event date time string ISO format" },
        "lang": { "type": "string", "description": "Preferred language 'en' or 'bm'" },
        "status": { "type": "string", "description": "Order status", "enum": ["pending", "approved", "billed", "cancel_requested", "cancelled", "rejected"] },
        "preparationType": { "type": "string", "description": "Preparation style 'meal_box' or 'buffet'", "enum": ["meal_box", "buffet"] },
        "presetId": { "type": "string", "description": "ID of saved company preset used" },
        "department": { "type": "string", "description": "Department within organization" },
        "rejectionReason": { "type": "string", "description": "Reason provided when admin rejects order" },
        "createdAt": { "type": "object", "description": "Firestore server timestamp" },
        "prices": { "type": "object", "description": "Object mapping meal key to price value" },
        "totalAmount": { "type": "number", "description": "Grand total amount for the order" },
        "invoiceNo": { "type": "string", "description": "Official generated invoice number" },
        "approvedAt": { "type": "string", "description": "Timestamp of order approval" },
        "billedAt": { "type": "string", "description": "Timestamp when billing/invoice email was sent" },
        "cancelledAt": { "type": "string", "description": "Timestamp when order was cancelled" },
        "rejectedAt": { "type": "string", "description": "Timestamp when order was rejected" },
        "updatedAt": { "type": "string", "description": "Timestamp when order was last updated" }
      },
      "required": ["name", "email", "contact", "location", "quantity", "meals", "preparationType", "status"]
    },
    "CompanyPreset": {
      "title": "CompanyPreset",
      "description": "Saved corporate address and contact details presets per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "presetName": { "type": "string", "description": "Name given to this preset" },
        "companyName": { "type": "string", "description": "Organization / Company Name" },
        "department": { "type": "string", "description": "Department name" },
        "billingAddress": { "type": "string", "description": "Billing address" },
        "deliveryAddress": { "type": "string", "description": "Delivery location / address" },
        "contactName": { "type": "string", "description": "Default contact person name" },
        "contactPhone": { "type": "string", "description": "Default contact phone number" },
        "contactEmail": { "type": "string", "description": "Default contact email address" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" }
      },
      "required": ["userId", "presetName", "companyName", "deliveryAddress", "contactName", "contactEmail"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit trail for admin and order operations",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Action name e.g. order_approved, invoice_generated" },
        "performedBy": { "type": "string", "description": "User or Admin ID who performed action" },
        "performedByName": { "type": "string", "description": "Name or email of operator" },
        "targetType": { "type": "string", "description": "Target entity type: order, invoice, preset" },
        "targetId": { "type": "string", "description": "Target document ID" },
        "details": { "type": "string", "description": "Additional context or payload summary" },
        "timestamp": { "type": "string", "description": "ISO timestamp of action" }
      },
      "required": ["action", "performedBy", "targetType", "targetId", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profiles containing saved corporate and contact details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Contact person name" },
        "email": { "type": "string", "description": "Contact email address" },
        "contact": { "type": "string", "description": "Contact telephone number" },
        "to": { "type": "string", "description": "Saved organization or company name" },
        "attn": { "type": "string", "description": "Saved departmental attention details" },
        "updatedAt": { "type": "string", "description": "Profile modification date" },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "orderStatus": { "type": "boolean", "description": "Subscribe to order status updates" },
            "billedUpdates": { "type": "boolean", "description": "Subscribe to billed/invoice updates" },
            "cancelApproval": { "type": "boolean", "description": "Subscribe to cancellation approval updates" }
          },
          "description": "User push notification subscription preferences"
        },
        "savedLocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "address": { "type": "string" }
            },
            "required": ["id", "label", "address"]
          },
          "description": "User saved physical delivery locations / event venues"
        }
      },
      "required": ["name", "email", "contact"]
    },
    "CalendarNote": {
      "title": "CalendarNote",
      "description": "Custom scheduling calendar notes written by admin or customers",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date of note (YYYY-MM-DD)" },
        "userId": { "type": "string", "description": "User ID who wrote the note, or 'admin'" },
        "userName": { "type": "string", "description": "Author display name" },
        "note": { "type": "string", "description": "The text content of the note" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of modification" }
      },
      "required": ["date", "userId", "note"]
    },
    "RestaurantMetadata": {
      "title": "RestaurantMetadata",
      "description": "Live metadata status parameters for restaurant dashboard",
      "type": "object",
      "properties": {
        "isOpen": { "type": "boolean", "description": "Whether restaurant is currently open" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp contact number" },
        "whatsappMessage": { "type": "string", "description": "Default WhatsApp message template" },
        "cateringTitle": { "type": "string", "description": "Catering header banner title" },
        "businessHours": { "type": "string", "description": "Business hours subtitle" },
        "footerAnnouncement": { "type": "string", "description": "Footer tagline or announcement text" }
      }
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection storing catering booking orders"
    },
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection storing customer profiles"
    },
    "company_presets/{presetId}": {
      "schema": "CompanyPreset",
      "description": "Collection storing saved corporate profile presets"
    },
    "audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Collection storing system audit trail"
    },
    "calendar_notes/{noteId}": {
      "schema": "CalendarNote",
      "description": "Collection storing custom schedule notes per date"
    },
    "restaurant_metadata/{metadataId}": {
      "schema": "RestaurantMetadata",
      "description": "Collection storing live restaurant metadata status parameters"
    }
  }
}
