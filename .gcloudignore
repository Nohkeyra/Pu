# This file is used by the gcloud CLI and Google Cloud Build to define which files to ignore.
# Since dist/ is in .gitignore, gcloud would default to ignoring it, which causes "Build artifacts are empty" errors on deployment.
# This file overrides that behavior to ensure dist/ is uploaded, while ignoring large, unnecessary directories.

.gcloudignore
.git
.gitignore
.github/
node_modules/
android/
!dist/
