# Treat binary files properly - NEVER modify line endings
*.jar binary
*.jks binary
*.keystore binary
*.aab binary
*.apk binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary

# Treat text files normally
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

