<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm espresso background, matching the app's dark-mode header family. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/widget_dark_header_start"
                android:endColor="@color/widget_dark_header_end" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/widget_dark_border" />
        </shape>
    </item>
    <!-- Native vector adaptation of the existing Wawasan six-petal batik ornament. -->
    <item
        android:drawable="@drawable/widget_batik_vector"
        android:gravity="right|center_vertical"
        android:width="154dp"
        android:height="80dp"
        android:right="4dp" />
    <!-- Fade on the reading side protects the logo, title and counter. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F23B2D26"
                android:centerColor="#B33B2D26"
                android:endColor="#003B2D26" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
