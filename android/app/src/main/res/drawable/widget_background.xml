<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Deep Base & Clean Stroke Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_background" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_stroke" />
        </shape>
    </item>
    <!-- Inner Deep Canvas Gradient -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#151E19"
                android:centerColor="#0E1411"
                android:endColor="#0B100E"
                android:type="linear" />
            <corners android:radius="22.5dp" />
        </shape>
    </item>
    <!-- Subtle Top Highlight Rim for Glass Elevation Polish -->
    <item android:left="4dp" android:right="4dp" android:top="3dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#283A31" />
        </shape>
    </item>
</layer-list>


