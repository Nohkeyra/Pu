<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Deep Shadow / Stroke Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_background" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_stroke" />
        </shape>
    </item>
    <!-- Inner Dimmer Batik Vector Overlay Gradient -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#141E19"
                android:centerColor="#0F1612"
                android:endColor="#111A16"
                android:type="linear" />
            <corners android:radius="20.5dp" />
        </shape>
    </item>
    <!-- Subtle Top Highlight Line for Glass/Vector Polish -->
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#22362C" />
        </shape>
    </item>
</layer-list>


