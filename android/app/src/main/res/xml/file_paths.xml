<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- F-05 (audit): scoped to subfolders so FileProvider cannot
         be coerced into reading arbitrary files in external or
         cache storage. -->
    <cache-path        name="shared_invoices"  path="shared_invoices/" />
    <external-files-path name="shared_invoices" path="shared_invoices/" />
    <external-cache-path name="shared_invoices" path="shared_invoices/" />
</paths>
