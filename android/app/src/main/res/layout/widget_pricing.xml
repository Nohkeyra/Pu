<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header Bar: Title + Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/pricing_widget_header_clickable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pricing_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TETAPKAN HARGA"
                android:textColor="@color/widget_title_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/pricing_widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restoran Wawasan — Tempahan Hari Ini"
                android:textColor="@color/widget_tertiary_text"
                android:textSize="9.5sp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Refresh button -->
        <ImageButton
            android:id="@+id/pricing_widget_refresh_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@drawable/widget_refresh_bg"
            android:tint="@color/widget_title_text"
            android:contentDescription="Muat Semula" />

    </LinearLayout>

    <!-- Today's summary pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_summary_pill_bg"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/pricing_widget_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_title_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Memuatkan..." />
    </LinearLayout>

    <!-- Orders ListView -->
    <ListView
        android:id="@+id/pricing_widget_orders_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/pricing_widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Tiada tempahan aktif hari ini\nKetik untuk muat semula"
        android:textColor="@color/widget_tertiary_text"
        android:textSize="11.5sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

</LinearLayout>
