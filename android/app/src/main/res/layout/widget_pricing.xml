<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header Bar: Title + Refresh -->
    <LinearLayout
        android:id="@+id/pricing_widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pricing_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEMPAHAN"
                android:textColor="@color/widget_title_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:singleLine="true" />

            <TextView
                android:id="@+id/pricing_widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum Key-in Harga (Lalu &amp; Baru)"
                android:textColor="@color/widget_tertiary_text"
                android:textSize="9.5sp"
                android:letterSpacing="0.03"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tactile Circular Refresh Button -->
        <ImageButton
            android:id="@+id/pricing_widget_refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@drawable/widget_refresh_bg"
            android:tint="@color/widget_title_text"
            android:contentDescription="Muat Semula" />

    </LinearLayout>

    <!-- Summary pill (Hidden) -->
    <LinearLayout
        android:id="@+id/pricing_widget_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_summary_pill_bg"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pricing_widget_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_title_accent"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="Memuatkan..."
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scrollable ListView for Unpriced Orders -->
    <ListView
        android:id="@+id/pricing_widget_orders_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:nestedScrollingEnabled="true"
        android:visibility="visible" />

    <TextView
        android:id="@+id/pricing_widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_muted_text"
        android:textSize="11sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

</LinearLayout>

