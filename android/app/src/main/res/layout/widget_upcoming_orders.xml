<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Left Section: Title & Brand Indicator -->
    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KATERING"
            android:textColor="@color/widget_title_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wawasan"
            android:textColor="@color/widget_tertiary_text"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Vertical Divider Line -->
    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:background="@color/widget_divider"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp" />

    <!-- Center Section: The actual purpose summary text -->
    <LinearLayout
        android:id="@+id/widget_today_summary_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_today_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_primary_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Memuatkan jadual..." />
    </LinearLayout>

    <!-- Hidden list to satisfy WidgetUpdateService binding constraints -->
    <ListView
        android:id="@+id/widget_orders_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Right Section: Compact Refresh Button -->
    <ImageButton
        android:id="@+id/widget_refresh_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="5dp"
        android:src="@android:drawable/ic_menu_rotate"
        android:background="@drawable/widget_refresh_bg"
        android:tint="@color/widget_title_text"
        android:contentDescription="Muat Semula"
        android:layout_marginStart="6dp" />

</LinearLayout>
