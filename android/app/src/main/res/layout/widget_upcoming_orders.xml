<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_header_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Scrollable ListView (Displays only the food menu for each order) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <ListView
            android:id="@+id/widget_orders_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:divider="@android:color/transparent"
            android:dividerHeight="1dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="✓ Tiada jadual tempahan akan datang" />
    </FrameLayout>

    <!-- Hidden dummy elements to safely satisfy other Java bindings without crash/errors -->
    <LinearLayout
        android:id="@+id/widget_today_summary_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_today_summary"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Compact Refresh Button on the right -->
    <ImageButton
        android:id="@+id/widget_refresh_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="5dp"
        android:src="@android:drawable/ic_menu_rotate"
        android:background="@drawable/widget_refresh_bg"
        android:tint="@color/widget_title_text"
        android:contentDescription="Muat Semula"
        android:layout_marginStart="6dp" />

</LinearLayout>
