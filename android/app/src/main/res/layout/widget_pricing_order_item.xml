<?xml version="1.0" encoding="utf-8"?>
<!--
  Each row in the pricing widget list.

  Layout (top to bottom):
    Company name  |  Pax badge
    Menu (truncated, 1 line)
    Meal types  +  "Tetapkan Harga" / "Sudah Dibil" button

  Tapping the row's main area, or specifically the "Tetapkan Harga" button,
  opens PricingInputActivity via the ListView's PendingIntentTemplate
  (orderId is passed as fillInIntent extra).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:padding="10dp">

    <!-- Row 1: Company + pax -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/pricing_item_company"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_primary_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Syarikat" />

        <TextView
            android:id="@+id/pricing_item_pax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:textColor="@color/widget_badge_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="-- pax" />
    </LinearLayout>

    <!-- Row 2: Menu (truncated) -->
    <TextView
        android:id="@+id/pricing_item_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_tertiary_text"
        android:textSize="9.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="6dp"
        android:text="Menu: -" />

    <!-- Row 3: Meal type pills + action button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pricing_item_meals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_title_text"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:text="Sarapan" />

        <!-- "Tetapkan Harga" button — tap triggers PricingInputActivity via fillInIntent -->
        <TextView
            android:id="@+id/pricing_item_action_btn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/widget_summary_pill_bg"
            android:textColor="@color/widget_title_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚡ Tetapkan Harga" />

    </LinearLayout>

</LinearLayout>
