+/* Member workspace: one primary booking action, then four quiet shortcuts. */
+.customer-dashboard-page .customer-dashboard-content { max-width: 1040px; display: flex; flex-direction: column; gap: 28px; }
+.customer-dashboard-page .customer-dashboard-welcome { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(180px, .8fr); align-items: center; gap: 24px; padding: 32px; border: 1px solid var(--ui-border); border-radius: 24px 24px 8px 24px; background: var(--ui-raised); box-shadow: var(--rw-paper-shadow); position: relative; isolation: isolate; }
+.customer-dashboard-welcome-copy { min-width: 0; }
+.customer-dashboard-eyebrow { color: var(--ui-action); font-size: .75rem; font-weight: 700; letter-spacing: .12em; }
+.customer-dashboard-welcome-copy h2 { margin: 10px 0 6px; font: 750 clamp(1.75rem, 3.5vw, 2.75rem)/1.1 var(--font-display); letter-spacing: -.03em; color: var(--ui-ink); }
+.customer-dashboard-identity { font-size: .875rem; color: var(--ui-muted); overflow-wrap: anywhere; }
+.customer-dashboard-verify { display: flex; align-items: flex-start; gap: 8px; font-size: .8125rem; line-height: 1.5; margin-top: 12px; }
+.customer-dashboard-verify svg { width: 18px; height: 18px; flex: none; color: var(--ui-action); }
+.customer-dashboard-page .customer-dashboard-booking-button { margin-top: 20px; min-height: 48px; border-radius: 12px; background: var(--ui-action); color: var(--ui-on-action); white-space: normal; height: auto; }
+.customer-dashboard-welcome-art { position: relative; isolation: isolate; }
+.customer-dashboard-welcome-art::before { content: ''; position: absolute; z-index: -1; inset: 12% 7%; border-radius: 50% 50% 16px 16px; background: var(--ui-yellow); transform: rotate(8deg); }
+.customer-dashboard-welcome-art > svg { display: block; width: 100%; height: auto; filter: drop-shadow(0 14px 10px color-mix(in srgb, var(--ui-shadow-ink) 14%, transparent)); }
+.customer-dashboard-shortcuts-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 6px 16px; margin-bottom: 16px; }
+.customer-dashboard-shortcuts-heading h2 { font: 700 1.25rem/1.3 var(--font-display); color: var(--ui-ink); }
