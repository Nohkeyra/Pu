# Firebase Admin SDK Service Account Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Admin JWT Secret (Required for production)
ADMIN_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMTP / Email (Brevo / Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASS=your-brevo-smtp-password
SENDER_EMAIL=your-sender@email.com

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# AI API Key (Optional - for MCP endpoint authorization)
AI_API_KEY=your-optional-ai-api-key

# Additional Allowed Origins (comma-separated, no spaces)
# SECURITY: Only add exact origins you control. Never use broad wildcards.
ADDITIONAL_ALLOWED_ORIGINS=https://your-custom-domain.com,https://another-domain.com

# Local Development Fallback
ENABLE_LOCAL_FALLBACK=false

# Node Environment
NODE_ENV=production
