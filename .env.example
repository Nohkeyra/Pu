# SMTP Configuration for sending emails via Brevo SMTP relay
# NOTE: Render blocks outbound port 587. Must use port 2525 for Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_brevo_login@email.com
SMTP_PASS=your_brevo_smtp_key
# Optional: the "From" address shown on outgoing emails (defaults to SMTP_USER)
SENDER_EMAIL=wawasan.orders@gmail.com

# Order status-change notifications (email + push to the customer)
# When an admin changes an order's status in the dashboard, the customer is
# emailed (and, if their device FCM token is known, sent a push notification).
# Set to "false" to disable this feature entirely. Default: enabled.
ENABLE_ORDER_STATUS_NOTIFICATIONS=true

# Firebase Configuration -- SERVER-SIDE (server/config.ts). Optional: only
# `FIREBASE_PROJECT_ID` is actually read at runtime (for Admin SDK init and
# the /api/health projectId field). The rest have hardcoded fallback
# defaults in server/config.ts and can be left empty.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Configuration -- FRONTEND / VITE (src/firebaseConfig.ts). These
# ARE required for the web build to work -- note the VITE_ prefix, without
# which Vite will not expose the value to client code. Do not confuse
# these with the server-side FIREBASE_* vars above; they are separate.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Workspace / Calendar Integration (Service Account Setup)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Backend safety switches (recommended defaults for Render)
# If true (default), the backend will FAIL HARD if service account creds are missing
# (prevents silent writes to the wrong place / local ephemeral disk).
STRICT_FIREBASE_ADMIN=true
# If true, backend will write orders to a local `orders.json` fallback when Firestore fails.
# Not recommended on Render (ephemeral disk) and NOT recommended for production.
ENABLE_LOCAL_FALLBACK=false
# Enables debug-only endpoints like `/api/widget/debug-all-orders`
ENABLE_DEBUG_ENDPOINTS=false

# Shared secret required (as an X-Widget-Key header) to call
# GET /api/widget/upcoming-orders. This endpoint returns customer names,
# delivery locations, and order details for the Android home-screen widget,
# so it is NOT public — the server refuses all requests if this is unset.
# Generate with: openssl rand -hex 32
# Must match the WIDGET_API_KEY GitHub Secret used to build the Android app
# (baked into the APK at build time via android/app/build.gradle).
WIDGET_API_KEY=

# External API Base URL (Required for native mobile builds / APKs to connect to this server)
# Example: VITE_API_URL=https://your-server-url.com
VITE_API_URL=
VITE_API_URL_ANDROID=https://restoran-wawasan-bio.onrender.com

# Admin Configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=your_admin_password
# Secret used to sign admin session tokens (JWT), issued after a successful
# /api/admin/login. REQUIRED on Render — if unset, the server falls back to a
# random secret generated at startup, which invalidates all admin sessions
# every time the server restarts (e.g. on every deploy). Set this to a long,
# random string in Render's dashboard. Example generation: `openssl rand -hex 32`
ADMIN_JWT_SECRET=

# Bank Account Details (for PDF Invoice generation)
# Optional: if left empty, defaults to RESTORAN WAWASAN / BANK MUAMALAT / 16010000-405710
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_ACCOUNT_NAME=
