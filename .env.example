# -----------------------------------------------------------------------------
# Wawasan MCP OAuth
# -----------------------------------------------------------------------------
# Public issuer used by Claude during OAuth discovery.
MCP_OAUTH_ISSUER=https://restoran-wawasan-bio.onrender.com

# Firebase Web API key used only for Firebase Authentication email/password login
# during the MCP OAuth authorization screen. Do not put a user password here.
FIREBASE_API_KEY=

# Existing Wawasan admin allowlist. Keep your current value(s).
ADMIN_EMAILS=
# ADMIN_EMAIL=example@example.com

# Existing Firebase Admin service-account variables remain unchanged.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# FIREBASE_PROJECT_ID=restoran-wawasan

# Legacy temporary bearer token. Not used by the OAuth MCP endpoint.
MCP_ACCESS_TOKEN=
